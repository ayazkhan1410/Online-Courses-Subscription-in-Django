DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4780,http://127.0.0.1:4780
CSRF_TRUSTED_ORIGINS=http://localhost:4780,http://127.0.0.1:4780
FRONTEND_URL=http://localhost:4780
FRONTEND_INTERNAL_URL=http://localhost:4780
API_PUBLIC_URL=http://localhost:4781

# PostgreSQL (local / docker-compose). Prefer DATABASE_URL in production (Neon pooler).
POSTGRES_DB=courses
POSTGRES_USER=courses
POSTGRES_PASSWORD=courses
POSTGRES_HOST=localhost
# Use 5433 when connecting to Docker Compose Postgres from the host.
# Backend container overrides this to db:5432 via docker-compose.yml.
POSTGRES_PORT=5433
# DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
GOOGLE_OAUTH_CLIENT_ID=390678818433-j78fbcj6cim9ui26ch9rhq37v04uchiv.apps.googleusercontent.com

# Email: set BREVO_API_KEY in production (Render blocks SMTP). Local keeps inbox/SMTP.
BREVO_API_KEY=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Fernet key for authenticator secrets. Required when DJANGO_DEBUG is False.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Cloudflare Turnstile. For local/dev, set TEST_MODE=True (widget hidden; API skips check).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_TEST_MODE=True

FIVERR_PROFILE_URL=

# YouTube Data API (playlist sync: manage.py sync_playlists / cron)
YOUTUBE_API_KEY=

# HTTPS cron (Render free has no scheduler). Required for /api/internal/cron/*
# python -c "import secrets; print(secrets.token_urlsafe(50))"
CRON_SECRET=

# Optional one-time admin on boot (ensure_superuser). Never printed.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Local/e2e: locmem + file inbox for Playwright
# EMAIL_BACKEND=utils.mail_backend.InboxLocmemEmailBackend
# EMAIL_INBOX_ENABLED=True
