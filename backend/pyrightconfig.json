{
  "include": ["."],
  "exclude": [
    "**/__pycache__",
    "staticfiles",
    "media"
  ],
  "venvPath": "..",
  "venv": "venv",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "executionEnvironments": [
    {
      "root": ".",
      "pythonVersion": "3.14",
      "extraPaths": ["."]
    }
  ]
}
